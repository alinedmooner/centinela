# Copia este archivo como .env y pon tu clave. El archivo .env nunca se sube al repositorio.
# Solo hace falta para los detectores y las pruebas que usan Claude; el modo de reglas funciona sin clave.
ANTHROPIC_API_KEY=
# Otros proveedores (opcionales): --proveedor google o --proveedor openrouter.
# GOOGLE_API_KEY es una clave de Google AI Studio. La de OpenRouter debe ser una clave de API
# normal, no una clave de administración (esas no pueden pedir respuestas a los modelos).
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Demostración con correo (ejemplos/vigilar_buzon.py y ejemplos/enviar_pruebas.py).
# Con Gmail se usan contraseñas de aplicación, no la contraseña normal de la cuenta.
# Buzón que vigila el bot:
BUZON_USUARIO=
BUZON_CLAVE=
# BUZON_IMAP=imap.gmail.com            # solo si el dominio no es Gmail, Yahoo, Zoho u Outlook
# Cuenta que envía los correos de prueba:
PRUEBAS_USUARIO=
PRUEBAS_CLAVE=
# PRUEBAS_SMTP=smtp.gmail.com:465

# Demostración con Composio (ejemplos/composio_buzon.py): clave de un proyecto de la plataforma
# de desarrolladores (empieza por ak_; la clave ck_ de Composio Connect no sirve aquí) y el
# User ID con el que se conecta la cuenta de Gmail (el comando «conectar» la conecta).
COMPOSIO_API_KEY=
COMPOSIO_USUARIO=
