# Copy this file to .env and set your keys. The .env file is never committed to the repository.
# A key is only needed by the detectors and tests that use Claude; the rules mode works without one.
ANTHROPIC_API_KEY=
# Other providers (optional): --provider google or --provider openrouter.
# GOOGLE_API_KEY is a Google AI Studio key. The OpenRouter one must be a regular API key, not
# a management key (those cannot ask the models for answers).
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Mailbox demo (examples/watch_mailbox.py and examples/send_test_emails.py).
# With Gmail, use app passwords, not the regular password of the account.
# Mailbox the bot watches:
MAILBOX_USER=
MAILBOX_PASSWORD=
# MAILBOX_IMAP=imap.gmail.com            # only if the domain is not Gmail, Yahoo, Zoho or Outlook
# Account that sends the test emails:
TESTER_USER=
TESTER_PASSWORD=
# TESTER_SMTP=smtp.gmail.com:465

# Composio demo (examples/composio_mailbox.py): the key of a project of the developer platform
# (it starts with ak_; the ck_ key of Composio Connect does not work here) and the User ID the
# Gmail account is connected with (the «connect» command connects it).
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=
