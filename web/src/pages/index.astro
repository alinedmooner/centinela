---
import Base from '../layouts/Base.astro';
import Abierto from '../components/Abierto.astro';
import Cinta from '../components/Cinta.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import Equipo from '../components/Equipo.astro';
import Hero from '../components/Hero.astro';
import Iconos from '../components/Iconos.astro';
import Limites from '../components/Limites.astro';
import Navegacion from '../components/Navegacion.astro';
import Pie from '../components/Pie.astro';
import Problema from '../components/Problema.astro';
import Resultados from '../components/Resultados.astro';
import Sala from '../components/Sala.astro';
import Uso from '../components/Uso.astro';
---

<Base
  titulo="Centinela · Guardia para asistentes de IA que leen mensajes en español"
  descripcion="Guardia de código abierto para asistentes de IA que leen mensajes en español. Detecta órdenes escondidas y phishing, y deja en código las decisiones delicadas."
  ogDescripcion="Tu bot lee todo. Centinela lee primero. Código abierto, licencia MIT, Python 3.11+."
>
  <Iconos />
  <a class="cn-saltar" href="#contenido">Saltar al contenido</a>
  <Navegacion />
  <main id="contenido">
    <Hero />
    <Cinta />
    <Problema />
    <ComoFunciona />
    <Sala />
    <Cinta inversa />
    <Resultados />
    <Limites />
    <Uso />
    <Abierto />
    <Equipo />
  </main>
  <Pie />
</Base>

<script>
  import '../scripts/main.js';
</script>
