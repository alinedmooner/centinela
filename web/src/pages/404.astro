---
import Base from '../layouts/Base.astro';
---

<Base
  titulo="Página no encontrada · Centinela"
  descripcion="Esta página no existe."
  indexar={false}
>
  <main id="contenido" class="cn-contenedor cn-doc">
    <section class="cn-doc__bloque">
      <a class="cn-marca" href="/"><img src="/logo.svg" alt="" width="28" height="28" />CENTINELA</a>
      <p class="cn-insignia cn-etiqueta">Error 404</p>
      <h1 class="cn-hero__titulo">Esta página no existe.</h1>
      <p class="cn-hero__bajada">Puede que el enlace esté mal escrito o que la página se haya movido.</p>
      <p><a class="cn-boton cn-boton--primario" href="/">Volver al inicio</a></p>
    </section>
  </main>
</Base>
