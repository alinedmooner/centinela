---
// Portado de la landing generada con Lovable (pruebas.html).
import Base from '../layouts/Base.astro';
---
<Base
  titulo="Pruebas de la sala · Centinela"
  descripcion="Pruebas automáticas de la lógica de desarmado de Centinela."
  indexar={false}
>
<main id="contenido" class="cn-contenedor cn-doc">
  <div class="cn-doc__bloque">
    <a class="cn-marca" href="/"><img src="/logo.svg" alt="" width="28" height="28">CENTINELA</a>
    <h1 class="cn-hero__titulo">Pruebas de desarmar.js</h1>
    <p id="resumen" class="cn-etiqueta" aria-live="polite">Corriendo…</p>
    <ul id="pruebas" class="cn-pruebas"></ul>
  </div>
</main>
</Base>

<script>
  import '../scripts/pruebas.js';
</script>
