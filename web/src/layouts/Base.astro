---
// Plantilla común: <head>, fuentes y estilos del sistema de diseño Vigía.
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/componentes.css';
import '../styles/secciones.css';

interface Props {
  titulo: string;
  descripcion: string;
  ogTitulo?: string;
  ogDescripcion?: string;
  indexar?: boolean;
}

const {
  titulo,
  descripcion,
  ogTitulo = titulo,
  ogDescripcion = descripcion,
  indexar = true,
} = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site);
const FUENTES =
  'https://fonts.googleapis.com/css2?family=Big+Shoulders:wght@800;900&family=Big+Shoulders+Stencil:wght@900&family=Instrument+Sans:wght@400;500;600&family=Martian+Mono:wght@400;500&display=swap';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <meta property="og:title" content={ogTitulo} />
    <meta property="og:description" content={ogDescripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonica} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#050505" />
    {!indexar && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={FUENTES} />
  </head>
  <body>
    <slot />
  </body>
</html>
