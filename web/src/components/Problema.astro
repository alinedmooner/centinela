---
// Ported from the landing page generated with Lovable (index.html).
import { t } from '../i18n/index.js';
import LegacyAnchor from './LegacyAnchor.astro';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const tt = (key: string) => t(lang, key);
// The sample message is Spanish on purpose (it is what the product reads), and is marked
// as Spanish on a page in another language. Its English gloss is empty on the Spanish page.
const message = tt('problem.bot.message');
const gloss = tt('problem.bot.gloss');
---
<section id={tt('anchor.problem')} class="cn-seccion" aria-labelledby="problema-titulo">
  <LegacyAnchor lang={lang} anchor="anchor.problem" />
  <div class="cn-contenedor">
    <p class="cn-etiqueta cn-seccion__ojo">{tt('problem.eyebrow')}</p>
    <h2 id="problema-titulo" class="cn-aparece">{tt('problem.title')}</h2>
    <p class="cn-seccion__bajada cn-aparece">{tt('problem.lead')}</p>
    <div class="cn-rejilla-2">
      <article class="cn-pieza cn-aparece">
        <svg class="cn-icono cn-pieza__icono" aria-hidden="true"><use href="#i-terminal"/></svg>
        <h3 class="cn-pieza__titulo">{tt('problem.bot.title')}</h3>
        <div class="cn-remitente"><span class="cn-remitente__rotulo cn-etiqueta">{tt('problem.bot.sender_label')}</span>{lang === 'es' ? message : <span lang="es">{message}</span>}</div>
        {gloss && <p class="cn-sala__pista">{gloss}</p>}
      </article>
      <article class="cn-pieza cn-aparece">
        <svg class="cn-icono cn-pieza__icono" aria-hidden="true"><use href="#i-persona"/></svg>
        <h3 class="cn-pieza__titulo">{tt('problem.person.title')}</h3>
        <p class="cn-pieza__texto">{tt('problem.person.text')}</p>
      </article>
    </div>

    <figure class="cn-momento cn-aparece">
      <p class="cn-momento__cifras" aria-label={tt('problem.figure.aria')}>
        <del class="cn-momento__antes">23/70</del>
        <span class="cn-momento__flecha" aria-hidden="true">→</span>
        <ins class="cn-momento__despues">0/70</ins>
      </p>
      <figcaption class="cn-momento__texto">{tt('problem.figure.caption')}</figcaption>
    </figure>

    <div class="cn-ingles">
      <h3 class="cn-ingles__titulo cn-aparece">{tt('problem.english.title')}</h3>
      <div class="cn-rejilla-2">
        <ul class="cn-ingles__lista">
          <li class="cn-aparece">{tt('problem.english.item1')}</li>
          <li class="cn-aparece">{tt('problem.english.item2')}</li>
          <li class="cn-aparece">{tt('problem.english.item3')}</li>
        </ul>
        <figure class="cn-barras cn-aparece">
          <figcaption class="cn-etiqueta">{tt('problem.bars.caption')}</figcaption>
          <div class="cn-barras__fila"><span class="cn-barras__nombre">{tt('problem.bars.english')}</span><span class="cn-barras__pista"><span class="cn-barras__valor cn-barras__valor--en"></span></span><span class="cn-barras__cifra">{tt('problem.bars.english_value')}</span></div>
          <div class="cn-barras__fila"><span class="cn-barras__nombre">{tt('problem.bars.spanish')}</span><span class="cn-barras__pista"><span class="cn-barras__valor cn-barras__valor--es"></span></span><span class="cn-barras__cifra cn-barras__cifra--alta">{tt('problem.bars.spanish_value')}</span></div>
        </figure>
      </div>
    </div>
  </div>
</section>
