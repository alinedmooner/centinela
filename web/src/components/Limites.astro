---
// Ported from the landing page generated with Lovable (index.html).
import { t } from '../i18n/index.js';
import LegacyAnchor from './LegacyAnchor.astro';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const tt = (key: string) => t(lang, key);
const ITEMS = ['limits.item1', 'limits.item2', 'limits.item3', 'limits.item4', 'limits.item5', 'limits.item6'];
---
<section id={tt('anchor.limits')} class="cn-seccion" aria-labelledby="lim-titulo">
  <LegacyAnchor lang={lang} anchor="anchor.limits" />
  <div class="cn-contenedor">
    <div class="cn-aviso cn-aparece">
      <div class="cn-aviso__cabeza"><svg class="cn-icono" aria-hidden="true"><use href="#i-balanza"/></svg><h2 id="lim-titulo" class="cn-aviso__titulo">{tt('limits.title')}</h2></div>
      <ul class="cn-aviso__lista">
        {ITEMS.map((key) => <li>{tt(key)}</li>)}
      </ul>
    </div>
  </div>
</section>
