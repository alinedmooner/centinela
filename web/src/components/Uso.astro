---
// Ported from the landing page generated with Lovable (index.html).
import { t } from '../i18n/index.js';
import LegacyAnchor from './LegacyAnchor.astro';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const tt = (key: string) => t(lang, key);
---
<section id={tt('anchor.use')} class="cn-seccion" aria-labelledby="uso-titulo">
  <LegacyAnchor lang={lang} anchor="anchor.use" />
  <div class="cn-contenedor">
    <p class="cn-etiqueta cn-seccion__ojo">{tt('use.eyebrow')}</p>
    <h2 id="uso-titulo" class="cn-aparece">{tt('use.title')}</h2>
    <div class="cn-rejilla-2">
      <div class="cn-codigo cn-aparece">
        <div class="cn-codigo__barra cn-etiqueta"><span>bash</span><button class="cn-boton cn-boton--fantasma cn-boton--peq" type="button" data-copiar="cod-bash">{tt('js.copy.label')}</button></div>
<pre><code id="cod-bash">{tt('use.bash.code')}</code></pre>
      </div>
      <div class="cn-codigo cn-aparece">
        <div class="cn-codigo__barra cn-etiqueta"><span>python</span><button class="cn-boton cn-boton--fantasma cn-boton--peq" type="button" data-copiar="cod-py">{tt('js.copy.label')}</button></div>
<pre><code id="cod-py">{tt('use.python.code')}</code></pre>
      </div>
    </div>
  </div>
</section>
