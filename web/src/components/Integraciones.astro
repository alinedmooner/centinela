---
// Where to use Centinela: one example for each kind of bot. The snippets are dictionary
// entries (a list of lines each, in the language of the page) and are written as text, which
// Astro escapes, so the braces of Python are not read as expressions. Every name in them is
// checked against the library by tests/test_web_i18n.py.
import { t } from '../i18n/index.js';
import LegacyAnchor from './LegacyAnchor.astro';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const tt = (key: string) => t(lang, key);
// `id` pairs each copy button with its code block; the keys are the entry's dictionary keys.
const CASES = [
  { id: 'whatsapp', title: 'where.whatsapp.title', tool: 'where.whatsapp.tool', text: 'where.whatsapp.text', code: 'where.whatsapp.code' },
  { id: 'telegram', title: 'where.telegram.title', tool: 'where.telegram.tool', text: 'where.telegram.text', code: 'where.telegram.code' },
  { id: 'slack', title: 'where.slack.title', tool: 'where.slack.tool', text: 'where.slack.text', code: 'where.slack.code' },
  { id: 'discord', title: 'where.discord.title', tool: 'where.discord.tool', text: 'where.discord.text', code: 'where.discord.code' },
  { id: 'correo', title: 'where.email.title', tool: 'where.email.tool', text: 'where.email.text', code: 'where.email.code' },
  { id: 'chat-web', title: 'where.web_chat.title', tool: 'where.web_chat.tool', text: 'where.web_chat.text', code: 'where.web_chat.code' },
  { id: 'rag', title: 'where.rag.title', tool: 'where.rag.tool', text: 'where.rag.text', code: 'where.rag.code' },
  { id: 'leads', title: 'where.leads.title', tool: 'where.leads.tool', text: 'where.leads.text', code: 'where.leads.code' },
];
---
<section id={tt('anchor.where')} class="cn-seccion" aria-labelledby="donde-titulo">
  <LegacyAnchor lang={lang} anchor="anchor.where" />
  <div class="cn-contenedor">
    <p class="cn-etiqueta cn-seccion__ojo">{tt('where.eyebrow')}</p>
    <h2 id="donde-titulo" class="cn-aparece">{tt('where.title')}</h2>
    <p class="cn-seccion__bajada cn-aparece">{tt('where.lead')}</p>
    <div class="cn-codigo cn-codigo--linea cn-aparece cn-donde__patron">
<pre><code>{tt('where.pattern')}</code></pre>
    </div>
    <div class="cn-donde">
      {CASES.map((c, n) => (
        <details class="cn-donde__caso" open={n === 0}>
          <summary class="cn-donde__resumen">
            <span class="cn-donde__titulo">{tt(c.title)}</span>
            <span class="cn-etiqueta cn-donde__herramienta">{tt(c.tool)}</span>
          </summary>
          <p class="cn-donde__texto">{tt(c.text)}</p>
          <div class="cn-codigo">
            <div class="cn-codigo__barra cn-etiqueta"><span>python</span><button class="cn-boton cn-boton--fantasma cn-boton--peq" type="button" data-copiar={`donde-${c.id}`}>{tt('js.copy.label')}</button></div>
            <pre><code id={`donde-${c.id}`}>{tt(c.code)}</code></pre>
          </div>
        </details>
      ))}
    </div>
    <p class="cn-sala__nota cn-donde__nota" set:html={tt('where.note')} />
  </div>
</section>
