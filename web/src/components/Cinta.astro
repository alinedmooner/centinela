---
// Separador de cinta de precaución, con un texto que corre.
interface Props {
  inversa?: boolean;
}

const { inversa = false } = Astro.props;
const texto =
  'CENTINELA · REVISA ANTES DE OBEDECER · '.repeat(3) + 'CENTINELA · REVISA ANTES DE OBEDECER ·';
---

<div class:list={['cn-cinta', { 'cn-cinta--inversa': inversa }]} aria-hidden="true"><div class="cn-cinta__pista"><span class="cn-cinta__texto">{texto}&nbsp;</span><span class="cn-cinta__texto">{texto}&nbsp;</span></div></div>
