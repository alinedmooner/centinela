---
// Ported from the landing page generated with Lovable (index.html).
import { t } from '../i18n/index.js';
import LegacyAnchor from './LegacyAnchor.astro';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const tt = (key: string) => t(lang, key);
---
<section id={tt('anchor.team')} class="cn-seccion" aria-labelledby="equipo-titulo">
  <LegacyAnchor lang={lang} anchor="anchor.team" />
  <div class="cn-contenedor">
    <p class="cn-etiqueta cn-seccion__ojo">{tt('team.eyebrow')}</p>
    <h2 id="equipo-titulo" class="cn-aparece">{tt('team.title')}</h2>
    <ul class="cn-equipo">
      <li class="cn-pieza cn-aparece"><svg class="cn-icono" aria-hidden="true"><use href="#i-persona"/></svg><h3 class="cn-pieza__titulo">Luis Núñez</h3><p class="cn-etiqueta cn-pieza__texto">NeuronKids</p></li>
      <li class="cn-pieza cn-aparece"><svg class="cn-icono" aria-hidden="true"><use href="#i-persona"/></svg><h3 class="cn-pieza__titulo">Daniel Moreno</h3><p class="cn-etiqueta cn-pieza__texto">Alined Labs</p></li>
    </ul>
    <p class="cn-equipo__contacto">{tt('team.contact')} <a class="cn-enlace" href="mailto:daniel@alinedlabs.co">daniel@alinedlabs.co</a></p>
    <p class="cn-equipo__nota">{tt('team.note_hackathon')}</p>
    <div class="cn-aliados">
      <h3 class="cn-etiqueta">{tt('team.partners')}</h3>
      <!-- TODO: organizers and sponsors, as text and without logos -->
    </div>
    <p class="cn-equipo__nota">{tt('team.note_ai')}</p>
  </div>
</section>
