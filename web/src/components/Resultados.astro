---
// Ported from the landing page generated with Lovable (index.html).
// The numbers come from results/summary.md (English) and results/summary.es.md (Spanish).
import { t } from '../i18n/index.js';
import LegacyAnchor from './LegacyAnchor.astro';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const tt = (key: string, fields?: Record<string, string | number>) => t(lang, key, fields);
// The five pieces of evidence: their number and the keys of their figure, text and sample size.
const EVIDENCE = [
  { n: '01', value: 'results.e1.value', text: 'results.e1.text', size: 'results.e1.n' },
  { n: '02', value: 'results.e2.value', text: 'results.e2.text', size: 'results.e2.n' },
  { n: '03', value: 'results.e3.value', text: 'results.e3.text', size: 'results.e3.n' },
  { n: '04', value: 'results.e4.value', text: 'results.e4.text', size: 'results.e4.n' },
  { n: '05', value: 'results.e5.value', text: 'results.e5.text', size: 'results.e5.n' },
];
// The rows of the table: metric, baseline and Centinela.
const ROWS = [
  { metric: 'results.table.r1.metric', baseline: 'results.table.r1.baseline', centinela: 'results.table.r1.centinela' },
  { metric: 'results.table.r2.metric', baseline: 'results.table.r2.baseline', centinela: 'results.table.r2.centinela' },
  { metric: 'results.table.r3.metric', baseline: 'results.table.r3.baseline', centinela: 'results.table.r3.centinela' },
  { metric: 'results.table.r4.metric', baseline: 'results.table.r4.baseline', centinela: 'results.table.r4.centinela' },
  { metric: 'results.table.r5.metric', baseline: 'results.table.r5.baseline', centinela: 'results.table.r5.centinela' },
  { metric: 'results.table.r6.metric', baseline: 'results.table.r6.baseline', centinela: 'results.table.r6.centinela' },
  { metric: 'results.table.r7.metric', baseline: 'results.table.r7.baseline', centinela: 'results.table.r7.centinela' },
  { metric: 'results.table.r8.metric', baseline: 'results.table.r8.baseline', centinela: 'results.table.r8.centinela' },
];
---
<section id={tt('anchor.results')} class="cn-seccion" aria-labelledby="res-titulo">
  <LegacyAnchor lang={lang} anchor="anchor.results" />
  <div class="cn-contenedor">
    <p class="cn-etiqueta cn-seccion__ojo">{tt('results.eyebrow')}</p>
    <h2 id="res-titulo" class="cn-aparece">{tt('results.title')}</h2>
    <p class="cn-seccion__bajada cn-aparece">{tt('results.lead')}</p>
    <ul class="cn-evidencias">
      {EVIDENCE.map((e) => (
        <li class="cn-evidencia cn-aparece"><span class="cn-evidencia__num cn-etiqueta">{tt('results.evidence', { n: e.n })}</span><span class="cn-evidencia__cifra">{tt(e.value)}</span><p class="cn-evidencia__texto">{tt(e.text)}</p><span class="cn-evidencia__meta cn-etiqueta"><span>{tt(e.size)}</span><span>{tt('results.source')}</span></span></li>
      ))}
    </ul>
    <div class="cn-tabla-caja cn-aparece" tabindex="0" role="region" aria-label={tt('results.table.aria')}>
      <table class="cn-tabla">
        <caption class="cn-oculto">{tt('results.table.caption')}</caption>
        <thead><tr><th scope="col">{tt('results.table.col_metric')}</th><th scope="col">{tt('results.table.col_baseline')}</th><th scope="col">{tt('results.table.col_centinela')}</th></tr></thead>
        <tbody>
          {ROWS.map((r) => <tr><th scope="row">{tt(r.metric)}</th><td>{tt(r.baseline)}</td><td>{tt(r.centinela)}</td></tr>)}
        </tbody>
      </table>
    </div>
  </div>
</section>
