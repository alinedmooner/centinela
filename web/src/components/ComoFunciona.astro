---
// Ported from the landing page generated with Lovable (index.html).
import { t } from '../i18n/index.js';
import LegacyAnchor from './LegacyAnchor.astro';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const tt = (key: string) => t(lang, key);
---
<section id={tt('anchor.how')} class="cn-seccion cn-claro" aria-labelledby="como-titulo">
  <LegacyAnchor lang={lang} anchor="anchor.how" />
  <div class="cn-contenedor">
    <p class="cn-etiqueta cn-seccion__ojo">{tt('how.eyebrow')}</p>
    <h2 id="como-titulo" class="cn-aparece" set:html={tt('how.title')} />
    <figure class="cn-flujo cn-aparece">
      <svg class="cn-flujo__svg" viewBox="0 0 960 300" role="img" aria-labelledby="flujo-desc">
        <title id="flujo-desc">{tt('how.flow.desc')}</title>
        <g class="cn-flujo__lineas">
          <path id="ruta-principal" d="M150 80 H260 M400 80 H530 M690 80 H800"/>
          <path d="M330 110 V230 H560"/>
          <path d="M610 110 V200"/>
        </g>
        <path class="cn-flujo__ruta" d="M150 80 H260 M400 80 H530 M690 80 H800" fill="none"/>
        <g class="cn-flujo__nodos">
          <rect x="10" y="50" width="140" height="60"/><text x="80" y="86">{tt('how.flow.message')}</text>
          <rect class="cn-flujo__nodo--acento" x="260" y="50" width="140" height="60"/><text class="cn-flujo__t--acento" x="330" y="86">{tt('how.flow.guard')}</text>
          <rect x="530" y="50" width="160" height="60"/><text x="610" y="86">{tt('how.flow.classifier')}</text>
          <rect x="800" y="50" width="150" height="60"/><text x="875" y="86">{tt('how.flow.label')}</text>
          <rect class="cn-flujo__nodo--sala" x="510" y="200" width="200" height="60"/><text x="610" y="236">{tt('how.flow.room')}</text>
        </g>
        <g class="cn-flujo__rotulos">
          <text x="465" y="68">{tt('how.flow.no_signals')}</text>
          <text x="400" y="222">{tt('how.flow.suspicion')}</text>
          <text x="740" y="160">{tt('how.flow.invalid_1')}</text>
          <text x="740" y="178">{tt('how.flow.invalid_2')}</text>
        </g>
        <circle class="cn-flujo__punto" r="7" cx="0" cy="0"/>
      </svg>
    </figure>
    <ol class="cn-rejilla-4">
      <li class="cn-pieza cn-pieza--clara cn-aparece"><span class="cn-pieza__numero">01</span><h3 class="cn-pieza__titulo">{tt('how.step1.title')}</h3><p class="cn-pieza__texto">{tt('how.step1.text')}</p></li>
      <li class="cn-pieza cn-pieza--clara cn-aparece"><span class="cn-pieza__numero">02</span><h3 class="cn-pieza__titulo">{tt('how.step2.title')}</h3><p class="cn-pieza__texto">{tt('how.step2.text')}</p></li>
      <li class="cn-pieza cn-pieza--clara cn-aparece"><span class="cn-pieza__numero">03</span><h3 class="cn-pieza__titulo">{tt('how.step3.title')}</h3><p class="cn-pieza__texto">{tt('how.step3.text')}</p></li>
      <li class="cn-pieza cn-pieza--clara cn-aparece"><span class="cn-pieza__numero">04</span><h3 class="cn-pieza__titulo">{tt('how.step4.title')}</h3><p class="cn-pieza__texto">{tt('how.step4.text')}</p></li>
    </ol>
    <p class="cn-cierre cn-aparece"><span class="cn-resaltado">{tt('how.closing')}</span></p>
  </div>
</section>
